# Every variable the template understands. The real values live in .env.production (or in Vercel's Environment Variables).
# Copy these into Vercel > Project > Settings > Environment Variables (one set per client project).
# Only the first two are required. Everything else is optional and falls back to the default in src/nexus/config.ts.

# --- required ---
NEXT_PUBLIC_DERIV_APP_ID=your_deriv_app_id
NEXT_PUBLIC_DERIV_APP_NAME=Client App Name

# --- recommended ---
NEXT_PUBLIC_DERIV_ENV=production
# your Deriv affiliate / referral link (new sign-ups through the app are credited to you)
NEXT_PUBLIC_DERIV_REFERRAL_LINK=

# --- branding (optional) ---
NEXT_PUBLIC_TAGLINE=
NEXT_PUBLIC_LOGO_URL=            # e.g. /logo.svg or a full https:// image link; "none" = letter badge
NEXT_PUBLIC_SHOW_NAME_IN_HEADER=false
NEXT_PUBLIC_THEME_PRIMARY=       # main colour, e.g. #247203
NEXT_PUBLIC_THEME_TAB=           # page-tab colour
NEXT_PUBLIC_THEME_TAB_TEXT=
NEXT_PUBLIC_THEME_UP=            # buy / rise colour
NEXT_PUBLIC_THEME_DOWN=          # sell / fall colour
NEXT_PUBLIC_THEME_GLOW_A=
NEXT_PUBLIC_THEME_GLOW_B=
NEXT_PUBLIC_THEME_LIGHTNING=

# --- social icons in the header (empty = hidden) ---
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Premium Bots tab (optional) ---
NEXT_PUBLIC_PREMIUM_NOTICE=
NEXT_PUBLIC_PREMIUM_BADGE=
